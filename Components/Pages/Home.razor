@page "/"
@using SystemTimer = System.Timers.Timer;
@using Microsoft.JSInterop
@using BlazorWeb.Services
@using BlazorWeb.Models
@using System.Security.Principal;
@inject UserService UserService
@inject IJSRuntime JSRuntime
@inject IJSRuntime JS
@inherits ComponentBase

<PageTitle>@(tabActive ? $"{@PomodoroTimerString}" : "Pomodoro Timer")</PageTitle>

<style> html, body {background: url('@backgroundUrl');background-size: cover;background-color: grey;}</style>
<div id="outer-container">
    <h1 id="container-text">Welcome @GetUserName().ToString()!</h1>
    <h3 id="container-text">Streaks: @GetStreaks().ToString()</h3>
    <div id="inner-container">
        <button id="clock-container" @onclick="PomodoroToggle"
                style="--progress:@(GetPomodoroProgress())">
            <svg class="progress-ring" width="160" height="160">
                <circle class="progress-ring__bg" stroke-width="8" r="76" cx="80" cy="80" />
                <circle class="progress-ring__progress" stroke-width="8" r="76" cx="80" cy="80" />
            </svg>
            <p id="time-text">@PomodoroTimerString</p>
        </button>
        <div id="btn-next" @onclick="PomodoroReset">Next</div>
    </div>
    <div id="notes-panel">
        <h3>Notes</h3>
        @foreach (var note in notes)
        {
            <div class="note-item">
                <p>@note.Content</p>
                <button @onclick="() => DeleteNoteAsync(note.Id)">Delete</button>
            </div>
        }
        <div class="add-note">
            <input type="text" @bind="newNoteText" placeholder="Add a note..." />
            <button @onclick="AddNoteAsync">Add</button>
        </div>
    </div>
</div>
<div id="footer">Icons made from <a href="https://www.onlinewebfonts.com/icon">svg icons</a>is licensed by CC BY 4.0.    Images are generated by AI</div>
<audio style="display: none;" autoplay loop controls><source src="/Music/music.mp3" type="audio/mpeg" /></audio>








@code {
    private User? user;
    private CancellationTokenSource? timerCts;
    private bool jsInitialized = false;
    private bool showCelebration = false;
    private string backgroundUrl;
    private static bool tabActive = false;
    private DateTime currentTime = DateTime.Now;
    private DateTime nightEnd = DateTime.Today.AddHours(8);
    private DateTime nightStart = DateTime.Today.AddHours(20);

    private HttpClient _client = new HttpClient();
    private SystemTimer _timer = new SystemTimer(1000);

    private static readonly TimeSpan time25 = TimeSpan.FromMinutes(25);
    private static readonly TimeSpan time5 = TimeSpan.FromMinutes(5);

    private bool pomodoroActive = false;
    private TimeSpan pomodoroTime = time25;
    private TimeSpan pomodoroOriginalTimeSpan = time25;
    private DateTime pomodoroStartTime;
    private bool pomodoroWork = true;
    public string PomodoroTimerString { get {   return pomodoroTime.ToString(@"mm\:ss");   } }

    private List<Note> notes = new List<Note>();
    private string newNoteText = string.Empty;

    // Main methods-------------------------------------------------------------------------------------------------------
    protected override async Task OnInitializedAsync()
    {
        user = await UserService.GetUser();
        notes = user.Notes.ToList();
        GetBackground();

        _timer.Elapsed += (s, e) => Tick(e.SignalTime);
        _timer.AutoReset = true;
        _timer.Enabled = false;

        if (user != null && user.Streak > 0 && user.Streak % 7 == 0)
        {
            showCelebration = true;
        }
    }
    private void GetBackground()
    {
        if (user?.Streak >= 3)
        {
            backgroundUrl = user.Streak % 7 == 0 ? "/Backgrounds/background_fire2.png" : "/Backgrounds/background_streak.png";
        }
        else
        {
            backgroundUrl = (currentTime >= nightEnd && currentTime <= nightStart) ? "/Backgrounds/background_daytime.png" : "/Backgrounds/background_night.png";
        }
    }
    private string GetUserName() => WindowsIdentity.GetCurrent().Name.Split('\\').Last();
    private string GetStreaks() => user?.Streak.ToString() ?? "0";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("eval", @"
                document.addEventListener('visibilitychange', () => {
                    DotNet.invokeMethodAsync('BlazorWeb', 'OnVisibilityChanged', document.hidden);
                });
            ");
        }
    }
    [JSInvokable]
    public static void OnVisibilityChanged(bool hidden) => tabActive = (hidden ? true : false);

    // Pomodoro methods (finished)---------------------------------------------------------------------------------------------------
    private void StartTimer()
    {
        pomodoroStartTime = DateTime.Now;
        _timer.Start();
    }
    private void PauseTimer()
    {
        _timer.Stop();
    }
    private void PomodoroToggle()
    {
        if (pomodoroActive)
        {
            pomodoroOriginalTimeSpan = pomodoroTime;
            _timer.Stop();
        }
        else
        {
            pomodoroStartTime = DateTime.Now;
            _timer.Start();
        }
        pomodoroActive = !pomodoroActive;
    }
    private void PomodoroReset()
    {
        _timer.Stop();
        if (pomodoroWork)
        {
            pomodoroOriginalTimeSpan = time5;
        }
        else
        {
            pomodoroOriginalTimeSpan = time25;
        }
        pomodoroTime = pomodoroOriginalTimeSpan;
        pomodoroWork = !pomodoroWork;
        pomodoroActive = false;
    }
    private void Tick(DateTime signalTime)
    {
        var time = pomodoroOriginalTimeSpan.Subtract(signalTime - pomodoroStartTime).Add(TimeSpan.FromSeconds(1));
        if (pomodoroTime.TotalSeconds == 0)
        {
            PomodoroReset();
        }
        else
        {
            pomodoroTime = time;
        }
        InvokeAsync(StateHasChanged);
    }
    private int GetPomodoroProgress() => ((int)(pomodoroTime.TotalSeconds / pomodoroOriginalTimeSpan.TotalSeconds * 100));
	
    // Notes methods ()---------------------------------------------------------------------------------------------------
    private async Task AddNoteAsync()
    {
        if (!string.IsNullOrWhiteSpace(newNoteText))
        {
            await UserService.AddNote(newNoteText);
            newNoteText = string.Empty;
            notes = await UserService.GetNotes();
        }
    }
    private async Task DeleteNoteAsync(int noteId)
    {
        await UserService.DeleteNote(noteId);
        notes = await UserService.GetNotes();
    }
}